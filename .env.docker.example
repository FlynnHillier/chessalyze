# Copy to .env and fill in. Read by docker-compose.yml.

# The site's address, without scheme. "localhost" on your machine; the real
# subdomain on the server (its DNS A record must point at the server).
SITE_DOMAIN=localhost

# Any long random string: openssl rand -hex 24
POSTGRES_PASSWORD=

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application).
# Authorised redirect URI: https://<SITE_DOMAIN>/api/auth/callback/google
OAUTH_GOOGLE_CLIENTID=
OAUTH_GOOGLE_CLIENTSECRET=
