# Settings for both ways of running Chessalyze. Copy to .env and fill in.
# Each tool reads only the keys it uses and ignores the rest.

# --- Shared ---------------------------------------------------------------
# Google Cloud Console > Google Auth Platform > Clients > Web application.
# Authorised redirect URIs, one per address the site runs at:
#   http://localhost:3000/api/auth/callback/google   yarn dev
#   https://localhost/api/auth/callback/google       docker compose, on your machine
#   https://<SITE_DOMAIN>/api/auth/callback/google   docker compose, on a server
OAUTH_GOOGLE_CLIENTID=
OAUTH_GOOGLE_CLIENTSECRET=

# --- docker compose (docker-compose.yml) -----------------------------------
# The site's address, without scheme: "localhost", or the server's domain
# (its DNS record must point at the server).
SITE_DOMAIN=localhost
# Any long random string: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- yarn dev (Next.js, drizzle-kit, yarn db:migrate) ----------------------
# The database from docker-compose.dev.yml.
POSTGRES_URL=postgresql://chessalyze:chessalyze@localhost:5432/chessalyze
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
